# Telegram API app credentials (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telethon session of the account that owns the NetPlus subscriptions (no extension)
USER_SESSION=data/sessions/main_account

# Admin bot token from @BotFather
ADMIN_BOT_TOKEN=

# Optional customer-facing shop bot token from @BotFather
CUSTOMER_BOT_TOKEN=

# Your card for customer card-to-card payments (not NetPlus)
# Prefer setting card in admin bot menu «کارت مشتریان» (DB). These are fallbacks.
RESELLER_CARD_NUMBER=
RESELLER_CARD_HOLDER=
SUPPORT_TEXT=پیام خود را همین‌جا بفرستید؛ پشتیبانی پاسخ می‌دهد.

# --- Payment provider (active: Aban Gateway; Variz kept for later) ---
# Active provider: aban | variz | none
PAYMENT_PROVIDER=aban

# Aban Gateway — https://abangateway.ir/docs/api
# Use ag_test_… for sandbox (has simulate-payment). Switch to ag_live_… for real money.
ABANGATEWAY_API_KEY=
ABANGATEWAY_API_BASE=https://api.abangateway.ir/api/v1
# Optional webhook signing secret from Aban panel (HMAC-SHA256 of raw body)
ABANGATEWAY_WEBHOOK_SECRET=
# Optional per-invoice webhook URL (HTTPS). Leave empty to use panel default / poll-only.
ABANGATEWAY_CALLBACK_URL=

# Variz.app (kept; not used while PAYMENT_PROVIDER=aban)
# Secret = sk_live_... or sk_test_...  (Authorization Bearer)
# Key ID = pk_live_... (public; optional for us)
VARIZAPP_API_KEY=
VARIZAPP_KEY_ID=
VARIZAPP_API_BASE=https://api.variz.app/api
# HTTPS URL Variz redirects the customer to after pay (we poll verify; webhook not required)
# If the project has «میزبان‌های مجاز», add this host there.
VARIZAPP_CALLBACK_URL=https://t.me/fxonevpnbot
# Webhook signing secret from Variz panel (whsec_...) — only needed with public HTTPS webhook
VARIZAPP_WEBHOOK_SECRET=
VARIZAPP_WEBHOOK_HOST=0.0.0.0
VARIZAPP_WEBHOOK_PORT=8787

# Comma separated Telegram numeric IDs allowed to use the admin bot
ADMIN_IDS=

# Seconds to wait between finished queue jobs (not inside one renew)
QUEUE_GAP_SECONDS=10
# Customer "view info" local freshness + HTTP subscription-userinfo
INFO_CACHE_TTL_SECONDS=120
INFO_HTTP_TIMEOUT_SECONDS=20
INFO_HTTP_CONCURRENCY=4

# Vendor bot usernames
NETPLUS_BOT=@Bombejokerbot
FINEARTS_BOT=@FineArtsVPNBot

# Only push alerts to the admin bot if the vendor message is newer than this (hours).
# Older missed messages are still saved to the database silently.
ALERT_MAX_AGE_HOURS=12

# Also notify when a renew/create succeeds (true/false)
NOTIFY_SUCCESS=false

# Optional proxy for the admin bot HTTP connection, e.g. http://127.0.0.1:10809
BOT_PROXY=

LOG_LEVEL=INFO

# Admin web panel (localhost by default)
ADMIN_WEB_PASSWORD=
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8787
ADMIN_WEB_SECRET=

# Embedded with vpn-manager when password is set (default). Set 0 to disable.
ADMIN_WEB_ENABLED=
